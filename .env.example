# ============================================================
# AquaTrace — Environment Variables Reference
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# ---- Live Tracking Backend (live_track_ship/) ----
# Sign up at https://aisstream.io to get a free API key
AISSTREAM_API_KEY=your_aisstream_api_key_here

# Port for the live-tracking Node.js server (default: 3001)
PORT=3001

# Time in ms before a vessel with no AIS update is evicted (default: 2 hours)
VESSEL_STALE_TIMEOUT_MS=7200000

# Application environment: development | production
NODE_ENV=development
