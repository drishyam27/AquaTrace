# ─────────────────────────────────────────────
# ShipTrack — Environment Configuration
# ─────────────────────────────────────────────

# [REQUIRED] AISStream.io API Key
# Sign up at https://aisstream.io to obtain your free API key.
AISSTREAM_API_KEY=your_api_key_here

# [OPTIONAL] HTTP server port (default: 3001)
PORT=3001

# [OPTIONAL] Stale vessel eviction timeout in milliseconds (default: 7200000 = 2 hours)
# VESSEL_STALE_TIMEOUT_MS=7200000

# [OPTIONAL] Application environment
# NODE_ENV=production
